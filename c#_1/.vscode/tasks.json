{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Order Sync Failure",
      "type": "process",
      "command": "C:\\Program Files\\dotnet\\dotnet.exe",
      "args": ["run", "--project", "${workspaceFolder}/OrderSyncFailure.csproj"],
