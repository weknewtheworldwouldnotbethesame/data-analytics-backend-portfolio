        "lineageTag": "cf446c33-50a4-44b6-b105-4ea0bfdaf2e6",
        "measures": [
          {
            "name": "Total Orders",
            "expression": "COUNTROWS(Orders)",
            "formatString": "0",
            "lineageTag": "3439c7f7-0b07-4bad-9cf6-05331e27e099"
          },
          {
            "name": "Completed Orders",
            "expression": "CALCULATE([Total Orders], Orders[Status] = \"Completed\")",
            "formatString": "0",
            "lineageTag": "76bb39bc-b1c8-4a37-9d57-5bdb48de9b84"
          },
          {
            "name": "Open Failures",
            "expression": "CALCULATE([Total Orders], Orders[Status] = \"Failed\")",
            "formatString": "0",
            "lineageTag": "599c2180-00ee-40c0-9677-17246504c332"
          },
          {
            "name": "Completion Rate",
            "expression": "DIVIDE([Completed Orders], [Total Orders], 0)",
            "formatString": "0.0%",
            "lineageTag": "f1f108ce-c62a-4289-b591-947890904d94"
          },
          {
            "name": "Orders With Failures",
            "expression": "CALCULATE([Total Orders], Orders[FailureCount] > 0)",
            "formatString": "0",
            "lineageTag": "faeb243b-1be2-4482-bd18-8576f51a8b60"
          },
          {
            "name": "Recovered Orders",
            "expression": "SUM(Orders[Recovered])",
            "formatString": "0",
            "lineageTag": "4853648a-f3d1-41c9-b44d-08a6387a8c69"
          },
          {
            "name": "Recovery Rate",
            "expression": "DIVIDE([Recovered Orders], [Orders With Failures], 0)",
            "formatString": "0.0%",
            "lineageTag": "462634eb-d93d-4a7f-9084-92e662705ecf"
          },
          {
            "name": "Retry Attempts",
            "expression": "SUM(Orders[RetryCount])",
            "formatString": "0",
            "lineageTag": "57aa1269-a887-4dd8-8f36-91586d910c57"
          },
          {
            "name": "Average Recovery Minutes",
            "expression": "AVERAGE(Orders[ResolutionMinutes])",
            "formatString": "0.0",
            "lineageTag": "99a50577-528c-4d40-9283-5218d039bd41"
          },
          {
            "name": "Open Failure Rate",
            "expression": "DIVIDE([Open Failures], [Total Orders], 0)",
            "formatString": "0.0%",
            "lineageTag": "52bee4e2-3b36-41a4-90c2-7bf738e012f2"
          }
        ],
        "partitions": [
          {
            "name": "Orders",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFile), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Types = Table.TransformColumnTypes(Headers, {{\"OrderId\", Int64.Type}, {\"OrderNumber\", type text}, {\"OrderDate\", type date}, {\"Channel\", type text}, {\"Product\", type text}, {\"Quantity\", Int64.Type}, {\"Status\", type text}, {\"AttemptCount\", Int64.Type}, {\"FailureCount\", Int64.Type}, {\"RetryCount\", Int64.Type}, {\"Recovered\", Int64.Type}, {\"LastFailureType\", type text}, {\"ResolutionMinutes\", type number}, {\"DataOrigin\", type text}}, \"en-US\")",
                "in",
                "    Types"
              ],
              "type": "m"
            }
          }
        ]
