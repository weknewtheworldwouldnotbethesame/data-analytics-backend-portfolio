  "components": {
    "schemas": {
      "OrderInput": {
        "required": [
          "channel",
          "customerName",
          "orderNumber",
          "product"
        ],
        "type": "object",
        "properties": {
          "orderNumber": {
            "maxLength": 40,
            "minLength": 0,
            "type": "string"
          },
          "customerName": {
            "maxLength": 80,
            "minLength": 0,
            "type": "string"
          },
          "product": {
            "maxLength": 80,
            "minLength": 0,
            "type": "string"
          },
          "quantity": {
            "maximum": 10000,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "channel": {
            "minLength": 1,
            "pattern": "Web|Store|Partner",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "SendInput": {
        "required": [
          "scenario"
        ],
        "type": "object",
        "properties": {
          "scenario": {
            "minLength": 1,
            "pattern": "success|unavailable|timeout|invalid-response",
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "Analytics"
